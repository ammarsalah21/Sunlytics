    "# Clean Country names\n",
    "df1['Country'] = df1['Country'].str.strip().str.lower()\n",
    "df2['Country'] = df2['Country'].str.strip().str.lower()\n",
    "\n",
    "# Ensure Year is integer\n",
    "df1['Year'] = df1['Year'].astype(int)\n",
    "df2['Year'] = df2['Year'].astype(int)\n",
