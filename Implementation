    "        marker='x', linestyle='--', color=\"#CCCCCC\", linewidth=2, label='Forecasted Solar Electricity (to 2035)')\n",
    "\n",
    "ax.set_title(\"Global Solar Electricity Forecast to 2035\", color='white')\n",
    "ax.set_xlabel(\"Year\", color='white')\n",
    "ax.set_ylabel(\"Electricity (TWh)\", color='white')\n",
    "ax.tick_params(axis='x', colors='white')\n",
    "ax.tick_params(axis='y', colors='white')\n",
    "\n",
    "legend = ax.legend()\n",
    "for text in legend.get_texts():\n",
    "    text.set_color(\"white\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
