    "import pandas as pd\n",
    "import numpy as np\n",
    "from statsmodels.tsa.arima.model import ARIMA\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# --- Step 1: Load and clean the data ---\n",
    "df = pd.read_excel(r\"c:\\Users\\alhaiaah\\OneDrive\\Desktop\\Sunlytics Project\\merged_final1.xlsx\")\n",
    "df.columns = df.columns.str.strip()\n",
    "df[\"Year\"] = df[\"Year\"].astype(int)\n",
    "\n",
    "# --- Step 2: Forecast GSTI for each country to 2035 ---\n",
    "end_year = 2035\n",
    "results = []\n",
    "countries = df[\"Country\"].unique()\n",
    "\n",
    "for country in countries:\n",
    "    sub = df[df[\"Country\"] == country].sort_values(\"Year\")\n",
    "    ts_data = sub.set_index(\"Year\")[\"GSTI\"].dropna()\n",
    "    if ts_data.empty:\n",
    "        continue\n",
    "\n",
    "    # Convert index to PeriodIndex for proper ARIMA forecasting\n",
    "    ts = pd.Series(ts_data.values, index=pd.PeriodIndex(ts_data.index, freq='Y'))\n",
    "    \n",
    "    last_year = ts.index.max().year\n",
    "    last_val = ts.loc[str(last_year)]\n",
    "    forecast_val = last_val\n",
    "    method = \"LinearTrend\"\n",
    "\n",
    "    # Use ARIMA if enough data points are available\n",
    "    if len(ts) >= 6:\n",
    "        try:\n",
    "            model = ARIMA(ts, order=(1,1,1))\n",
    "            fit = model.fit()\n",
    "            steps = end_year - last_year\n",
    "            if steps > 0:\n",
    "                fc = fit.forecast(steps=steps)\n",
    "                forecast_val = float(fc.iloc[-1])\n",
    "            method = \"ARIMA(1,1,1)\"\n",
    "        except Exception as e:\n",
    "            # Fallback to LinearTrend if ARIMA fails\n",
    "            x = np.array(ts.index.year)\n",
    "            y = ts.values\n",
    "            m = np.sum((x - x.mean()) * (y - y.mean())) / np.sum((x - x.mean())**2)\n",
    "            b = y.mean() - m * x.mean()\n",
    "            forecast_val = m * end_year + b\n",
    "            method = \"LinearTrend (Fallback)\"\n",
    "    else:\n",
    "        # Use LinearTrend for short time series\n",
    "        x = np.array(ts.index.year)\n",
    "        y = ts.values\n",
    "        m = np.sum((x - x.mean()) * (y - y.mean())) / np.sum((x - x.mean())**2)\n",
    "        b = y.mean() - m * x.mean()\n",
    "        forecast_val = m * end_year + b\n",
    "        method = \"LinearTrend\"\n",
    "\n",
    "    abs_change = forecast_val - last_val\n",
    "    pct_change = (abs_change / last_val) * 100 if last_val != 0 else np.nan\n",
    "\n",
    "    results.append({\n",
    "        \"Country\": country,\n",
    "        \"LastYear\": last_year,\n",
    "        \"GSTI_last\": last_val,\n",
    "        \"GSTI_2035\": forecast_val,\n",
    "        \"AbsChange\": abs_change,\n",
    "        \"PctChange\": pct_change,\n",
    "        \"Method\": method,\n",
    "        \"N_obs\": len(ts)\n",
    "    })\n",
    "\n",
    "res_df = pd.DataFrame(results).sort_values(\"PctChange\", ascending=False).reset_index(drop=True)\n",
    "\n",
    "# --- Step 3: Forecast global average GSTI to 2035 ---\n",
    "global_ts_data = df.groupby(\"Year\")[\"GSTI\"].mean()\n",
    "\n",
    "# Convert global index to PeriodIndex for proper ARIMA forecasting\n",
    "global_ts = pd.Series(global_ts_data.values, index=pd.PeriodIndex(global_ts_data.index, freq='Y'))\n",
    "\n",
    "last_year = global_ts.index.max().year\n",
    "steps = end_year - last_year\n",
    "\n",
    "try:\n",
    "    model = ARIMA(global_ts, order=(1,1,1))\n",
    "    fit = model.fit()\n",
    "    fc = fit.forecast(steps=steps)\n",
    "    forecast_years = fc.index.year\n",
    "    forecast_values = fc.values\n",
    "    method_global = \"ARIMA(1,1,1)\"\n",
    "except Exception as e:\n",
    "    # Fallback to LinearTrend if ARIMA fails\n",
    "    x = np.array(global_ts.index.year)\n",
    "    y = global_ts.values\n",
    "    m = np.sum((x - x.mean()) * (y - y.mean())) / np.sum((x - x.mean())**2)\n",
    "    b = y.mean() - m * x.mean()\n",
    "    forecast_years = list(range(last_year + 1, end_year + 1))\n",
    "    forecast_values = [m * year + b for year in forecast_years]\n",
    "    method_global = \"LinearTrend (Fallback)\"\n",
    "\n",
    "# --- Step 4: Print summary statistics ---\n",
    "# --- Step 4: Print summary statistics ---\n",
    "print(\"=== GSTI Global Average ===\")\n",
    "print(f\"Last observed mean (across countries, last available year): {global_ts.iloc[-1]:.4f}\")\n",
    "print(f\"Forecast mean in {end_year}: {forecast_values[-1]:.4f} (Method: {method_global})\\n\")\n",
    "\n",
    "print(\"=== Top 10 Countries by % Increase in GSTI by 2035 ===\")\n",
    "\n",
    "\n",
    "print(\"=== Top 10 Countries by % Increase in GSTI by 2035 ===\")\n",
    "print(res_df.head(10)[[\"Country\", \"GSTI_last\", \"GSTI_2035\", \"PctChange\", \"Method\", \"N_obs\"]])\n",
    "\n",
    "\n",
    "# --- Step 6: Prepare values for plotting ---\n",
    "plot_years_actual = global_ts.index.year\n",
    "plot_values_actual = global_ts.values\n",
    "\n",
    "# --- Step 7: Plot global GSTI forecast ---\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "fig.patch.set_facecolor('#1E1E2F')\n",
    "ax.set_facecolor('#1E1E2F')\n",
    "\n",
    "ax.plot(plot_years_actual, plot_values_actual,\n",
    "        marker='o', linewidth=3, color='#6796C8', label='Actual GSTI (Global Mean)')\n",
    "ax.plot(forecast_years, forecast_values,\n",
    "        marker='x', linestyle='--', color=\"#CCCCCC\", linewidth=2, label='Forecasted GSTI (to 2035)')\n",
    "\n",
    "ax.set_title(\"Global GSTI Forecast to 2035\", color='white')\n",
    "ax.set_xlabel(\"Year\", color='white')\n",
    "ax.set_ylabel(\"GSTI Value\", color='white')\n",
    "ax.tick_params(axis='x', colors='white')\n",
    "ax.tick_params(axis='y', colors='white')\n",
    "\n",
    "legend = ax.legend()\n",
    "for text in legend.get_texts():\n",
    "    text.set_color(\"white\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
