    "\n",
    "# --- Prepare global annual data ---\n",
    "years = sorted(df['Year'].unique())\n",
    "global_values = []\n",
    "\n",
    "for year in years:\n",
    "    total = df[df['Year'] == year]['Electricity from solar (TWh)'].sum()\n",
    "    global_values.append(total)\n",
    "\n",
    "# --- Forecast global electricity from solar ---\n",
    "# We will use ARIMA on global annual totals\n",
    "global_series = pd.Series(global_values, index=years)\n",
    "model = ARIMA(global_series, order=(1,1,1))\n",
    "fit = model.fit()\n",
    "\n",
    "forecast_years = list(range(years[-1]+1, 2036))\n",
    "forecast_values = fit.forecast(steps=len(forecast_years))\n",
    "\n",
    "# --- Combine actual + forecast for plotting ---\n",
    "plot_years_actual = years\n",
    "plot_values_actual = global_values\n",
    "\n",
    "# --- Plot with specified colors ---\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "fig.patch.set_facecolor('#1E1E2F')\n",
    "ax.set_facecolor('#1E1E2F')\n",
