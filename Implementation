    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Step 1️⃣ Replace all zeros with NaN (only for numeric columns)\n",
    "for df in [main_df, efficiency_df, environment_df]:\n",
    "    numeric_cols = df.select_dtypes(include=[np.number]).columns\n",
    "    df[numeric_cols] = df[numeric_cols].replace(0, np.nan)\n",
    "\n",
    "# Step 2️⃣ Interpolate missing values by Country and Year\n",
    "for df in [main_df, efficiency_df, environment_df]:\n",
    "    df.sort_values([\"Country\", \"Year\"], inplace=True)\n",
    "    df.update(\n",
    "        df.groupby(\"Country\")\n",
    "          .apply(lambda g: g.interpolate(method=\"linear\", limit_direction=\"both\"))\n",
    "          .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "# Step 3️⃣ Save final cleaned and interpolated data into one Excel file\n",
    "final_filename = \"Final_Solar_Study_Areas.xlsx\"\n",
    "\n",
    "with pd.ExcelWriter(final_filename, engine=\"openpyxl\") as writer:\n",
    "    main_df.to_excel(writer, sheet_name=\"Main\", index=False)\n",
    "    efficiency_df.to_excel(writer, sheet_name=\"Efficiency\", index=False)\n",
    "    environment_df.to_excel(writer, sheet_name=\"Environment\", index=False)\n",
    "\n",
    "print(\"✅ Final interpolated data saved successfully to:\", final_filename)\n"
   ]
