    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# 1️⃣ Replace 0 with NaN for numeric columns (to avoid false zeros)\n",
    "for df in [main_df, efficiency_df, environment_df]:\n",
    "    numeric_cols = df.select_dtypes(include=[np.number]).columns\n",
    "    df[numeric_cols] = df[numeric_cols].replace(0, np.nan)\n",
    "\n",
    "# 2️⃣ Interpolate missing numeric values by country and year\n",
    "for df in [main_df, efficiency_df, environment_df]:\n",
    "    df.sort_values([\"Country\", \"Year\"], inplace=True)\n",
    "    df.update(\n",
    "        df.groupby(\"Country\")\n",
    "          .apply(lambda g: g.interpolate(method=\"linear\", limit_direction=\"both\"))\n",
    "          .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "# 3️⃣ Drop rows where \"World Bank's income classification\" == \"Unknown\" in main_df\n",
    "main_df = main_df[main_df[\"World Bank's income classification\"] != \"Unknown\"]\n",
    "\n",
    "# 4️⃣ Drop any rows that still contain null values (NaN)\n",
    "main_cleaned = main_df.dropna()\n",
    "efficiency_cleaned = efficiency_df.dropna()\n",
    "environment_cleaned = environment_df.dropna()\n",
    "\n",
    "# 5️⃣ Save all cleaned DataFrames into a new Excel file\n",
    "final_clean_filename = \"Final_Cleaned_Solar_Study_Areas.xlsx\"\n",
    "\n",
    "with pd.ExcelWriter(final_clean_filename, engine=\"openpyxl\") as writer:\n",
    "    main_cleaned.to_excel(writer, sheet_name=\"Main_Cleaned\", index=False)\n",
    "    efficiency_cleaned.to_excel(writer, sheet_name=\"Efficiency_Cleaned\", index=False)\n",
    "    environment_cleaned.to_excel(writer, sheet_name=\"Environment_Cleaned\", index=False)\n",
    "\n",
    "print(\"✅ Fully cleaned data saved successfully to:\", final_clean_filename)\n",
    "print(\"🗑️ Dropped rows in main_df where income classification was 'Unknown'.\")\n"
