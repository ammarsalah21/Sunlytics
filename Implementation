    "import pandas as pd\n",
    "\n",
    "# Assuming your merged and cleaned data is in \"cleaned_df\"\n",
    "# (if it's called merged_df instead, just replace it below)\n",
    "\n",
    "# 1️⃣ Main area — Growth & Urbanization\n",
    "main_df = cleaned_df[[\n",
    "    \"Country\",\n",
    "    \"Year\",\n",
    "    \"Solar capacity (total) (GW)\",\n",
    "    \"World Bank's income classification\",\n",
    "    \"Urban population\"\n",
    "]].copy()\n",
    "\n",
    "# 2️⃣ Efficiency area — Economic & Operational Efficiency\n",
    "efficiency_df = cleaned_df[[\n",
    "    \"Country\",\n",
    "    \"Year\",\n",
    "    \n",
    "    \"Solar capacity (total) (GW)\",\n",
    "    \"Solar per capita (kWh - equivalent)\",\n",
    "    \"GDP per capita\",\n",
    "    \"Electricity from solar - TWh\"\n",
    "]].copy()\n",
    "\n",
    "# 3️⃣ Environment area — Environmental Impact & Policies\n",
    "environment_df = cleaned_df[[\n",
    "    \"Country\",\n",
    "    \"Year\",\n",
    "    \"Solar (TWh growth - equivalent)\",\n",
    "    \"Annual CO₂ emissions (per capita)\",\n",
    "    \"Electricity from solar (TWh)\",\n",
    "    \"Solar (% equivalent primary energy)\"\n",
    "]].copy()\n",
    "\n",
    "# 4️⃣ Save all three to Excel files\n",
    "main_df.to_excel(\"Main_Data.xlsx\", index=False)\n",
    "efficiency_df.to_excel(\"Efficiency_Data.xlsx\", index=False)\n",
    "environment_df.to_excel(\"Environment_Data.xlsx\", index=False)\n",
    "\n",
    "print(\"✅ All DataFrames created and saved successfully!\")\n"
   ]
  },
