    "# 1️⃣ Define a function to clean the DataFrames\n",
    "def clean_table(df):\n",
    "    exclude_cols = [\"Country\", \"Year\"]\n",
    "    other_cols = [col for col in df.columns if col not in exclude_cols]\n",
    "    return df.dropna(subset=other_cols, how=\"all\").reset_index(drop=True)\n",
    "\n",
    "# 2️⃣ Apply cleaning to all three tables\n",
    "main_df = clean_table(main_df)\n",
    "efficiency_df = clean_table(efficiency_df)\n",
    "environment_df = clean_table(environment_df)\n",
    "\n",
    "# 3️⃣ Save them all into a NEW Excel file\n",
    "with pd.ExcelWriter(\"Cleaned_Solar_Study_Areas.xlsx\") as writer:\n",
    "    main_df.to_excel(writer, sheet_name=\"Main_Area\", index=False)\n",
    "    efficiency_df.to_excel(writer, sheet_name=\"Efficiency_Area\", index=False)\n",
    "    environment_df.to_excel(writer, sheet_name=\"Environment_Area\", index=False)\n",
    "\n",
    "print(\"✅ Cleaned data saved successfully in 'Cleaned_Solar_Study_Areas.xlsx'\")\n"
   ]
  },
