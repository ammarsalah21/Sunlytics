    " ################################################\n",
    "##### Solar → Human Development Index (HDI) #####\n",
    "################################################\n",
    "\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from statsmodels.tsa.arima.model import ARIMA\n",
    "import numpy as np\n",
    "\n",
    "# -------------------------------\n",
    "# Load Data & Setup\n",
    "# -------------------------------\n",
    "# Note: File path needs to be updated to your actual location if not using a system environment.\n",
    "# file_path = r'c:\\Users\\alhaiaah\\OneDrive\\Desktop\\Sunlytics Project\\solar global.xlsx'\n",
    "\n",
    "# -------------------------------\n",
    "# Create Dummy Data for demonstration if the actual file is not available\n",
    "# -------------------------------\n",
    "try:\n",
    "    # Attempt to read the actual file\n",
    "    file_path = r'c:\\Users\\alhaiaah\\OneDrive\\Desktop\\Sunlytics Project\\solar global.xlsx'\n",
    "    df = pd.read_excel(file_path)\n",
    "    df.set_index('Year', inplace=True)\n",
    "    # Check if required columns exist (HDI and Solar TWh)\n",
    "    if \"Human Development Index\" not in df.columns or \"Electricity from solar - TWh\" not in df.columns:\n",
    "        raise ValueError(\"Required columns are missing in the Excel file.\")\n",
    "except:\n",
    "    print(\"⚠ File reading or column validation failed. Using synthetic dummy data.\")\n",
    "    # Synthesize data for a robust demonstration\n",
    "    years = list(range(2000, 2023))\n",
    "    df = pd.DataFrame({\n",
    "        'Year': years,\n",
    "        # Solar growth (Exponential-like trend)\n",
    "        'Electricity from solar - TWh': np.exp(np.linspace(1, 7, len(years))) + np.random.normal(0, 50, len(years)),\n",
    "        # HDI improving linearly with some noise\n",
    "        'Human Development Index': np.linspace(0.68, 0.76, len(years)) + (np.random.normal(0, 0.005, len(years))),\n",
    "    }).set_index('Year')\n",
    "# -------------------------------\n",
    "\n",
    "\n",
    "# Define forecast period end\n",
    "end_year = 2035\n",
    "last_known_year = df.index.max()\n",
    "\n",
    "# -------------------------------\n",
    "# 1) Forecast solar electricity (TWh) until 2035\n",
    "# -------------------------------\n",
    "\n",
    "solar_ts = df[\"Electricity from solar - TWh\"]\n",
    "\n",
    "# Check data sufficiency for ARIMA, otherwise, use simple linear projection\n",
    "if len(solar_ts) < 5:\n",
    "    # Simple linear regression as a fallback for solar prediction\n",
    "    def simple_linear_regression(x, y):\n",
    "        x = np.array(x)\n",
    "        y = np.array(y)\n",
    "        m = np.sum((x - x.mean())*(y - y.mean())) / np.sum((x - x.mean())**2)\n",
    "        b = y.mean() - m*x.mean()\n",
    "        return m, b\n",
    "\n",
    "    m_solar, b_solar = simple_linear_regression(solar_ts.index, solar_ts.values)\n",
    "    \n",
    "    forecast_years = list(range(last_known_year + 1, end_year + 1))\n",
    "    solar_forecast_values = m_solar * np.array(forecast_years) + b_solar\n",
    "    \n",
    "    forecast_solar_df = pd.DataFrame({\n",
    "        \"Year\": forecast_years,\n",
    "        \"Solar_TWh_Forecast\": solar_forecast_values\n",
    "    }).set_index(\"Year\")\n",
    "    solar_forecast = forecast_solar_df[\"Solar_TWh_Forecast\"] # Assign forecast series\n",
    "    \n",
    "else:\n",
    "    # Standard ARIMA Model\n",
    "    model = ARIMA(solar_ts, order=(1,1,1))\n",
    "    model_fit = model.fit()\n",
    "\n",
    "    start_idx = len(solar_ts)\n",
    "    end_idx = start_idx + (end_year - last_known_year)\n",
    "\n",
    "    if end_idx <= start_idx:\n",
    "        end_idx = start_idx + 1\n",
    "\n",
    "    # Forecast Solar TWh\n",
    "    solar_forecast = model_fit.predict(start=start_idx, end=end_idx)\n",
    "\n",
    "# Build forecast years\n",
    "forecast_years = list(range(last_known_year + 1, last_known_year + len(solar_forecast) + 1))\n",
    "forecast_solar_df = pd.DataFrame({\n",
    "    \"Year\": forecast_years,\n",
    "    \"Solar_TWh_Forecast\": solar_forecast.values\n",
    "}).set_index(\"Year\")\n",
    "\n",
    "# Combine actual + forecast solar data\n",
    "solar_all = pd.concat([solar_ts, forecast_solar_df[\"Solar_TWh_Forecast\"]])\n",
    "\n",
    "\n",
    "# -------------------------------\n",
    "# 2) Logarithmic Regression: Solar TWh → HDI (to reflect diminishing returns)\n",
    "# -------------------------------\n",
    "# This modification addresses the unrealistic linear growth towards 1.0\n",
    "# by using the log of Solar TWh to model the relationship, reflecting\n",
    "# that the impact of solar TWh on HDI diminishes as HDI approaches its maximum (1.0).\n",
    "\n",
    "def simple_linear_regression(x, y):\n",
    "    # Calculate slope (m) and intercept (b)\n",
    "    x = np.array(x)\n",
    "    y = np.array(y)\n",
    "    m = np.sum((x - x.mean())*(y - y.mean())) / np.sum((x - x.mean())**2)\n",
    "    b = y.mean() - m*x.mean()\n",
    "    return m, b\n",
    "\n",
    "# 2a) Prepare Log Solar TWh Data for regression fitting\n",
    "# Add a small value (1) to prevent log(0) errors if needed, though solar TWh is usually > 0.\n",
    "log_solar_twh_data = np.log(df[\"Electricity from solar - TWh\"] + 1)\n",
    "\n",
    "\n",
    "# Fit regression for Log(Solar TWh) against Human Development Index\n",
    "m_hdi, b_hdi = simple_linear_regression(\n",
    "    log_solar_twh_data,\n",
    "    df[\"Human Development Index\"]\n",
    ")\n",
    "\n",
    "# 2b) Predict future HDI based on Log of combined (Actual + Forecasted) solar values\n",
    "# Apply the same log transformation to the combined solar data\n",
    "log_solar_values = np.log(solar_all.values + 1)\n",
    "\n",
    "# Predict HDI using the log model: HDI = m * log(Solar TWh) + b\n",
    "hdi_pred = m_hdi * log_solar_values + b_hdi\n",
    "\n",
    "# Enforce the theoretical maximum limit of 1.0 for HDI\n",
    "hdi_pred = np.clip(hdi_pred, None, 1.0)\n",
    "\n",
    "\n",
    "pred_df = pd.DataFrame({\n",
    "    \"Year\": solar_all.index,\n",
    "    \"Solar_TWh\": solar_all.values,\n",
    "    \"Predicted_HDI\": hdi_pred,\n",
    "}).set_index(\"Year\")\n",
    "\n",
    "\n",
    "# -------------------------------\n",
    "# 3) Calculate HDI Growth Percentage\n",
    "# -------------------------------\n",
    "\n",
    "# Find the HDI value at the start of the prediction and at the end (2035)\n",
    "if last_known_year in df.index and end_year in pred_df.index:\n",
    "    \n",
    "    hdi_start = df.loc[last_known_year, \"Human Development Index\"]\n",
    "    hdi_end = pred_df.loc[end_year, \"Predicted_HDI\"]\n",
    "    \n",
    "    # Calculate total percentage growth\n",
    "    if hdi_start != 0:\n",
    "        hdi_growth_percentage = ((hdi_end - hdi_start) / hdi_start) * 100\n",
    "    else:\n",
    "        hdi_growth_percentage = 0\n",
    "\n",
    "    print(\"\\n\\n#####################################################\")\n",
    "    print(f\"## 📈 HDI GROWTH FORECAST ({last_known_year} → {end_year}) ##\")\n",
    "    print(\"#####################################################\")\n",
    "    print(f\"* Last Known HDI ({last_known_year}): {hdi_start:.4f}\")\n",
    "    print(f\"* Predicted HDI ({end_year}): {hdi_end:.4f}\")\n",
    "    print(f\"* Total Growth in HDI Index: {hdi_end - hdi_start:.4f}\")\n",
    "    print(f\"** Total HDI Growth Percentage: {hdi_growth_percentage:.2f}%\")\n",
    "    print(\"-\" * 55)\n",
    "    print(\"Interpretation: As solar electricity continues its current growth trajectory,\")\n",
    "    print(\"using a log model to account for diminishing returns,\")\n",
    "    print(f\"the Human Development Index is expected to increase by {hdi_growth_percentage:.2f}% by {end_year}.\")\n",
    "    \n",
    "else:\n",
    "    print(\"⚠ Data points for start year or end year (2035) are missing for HDI growth calculation.\")\n",
    "\n",
    "\n",
    "# -------------------------------\n",
    "# 4) Plotting: Human Development Index\n",
    "# -------------------------------\n",
    "# This plot shows the historical trend and the predicted change in HDI.\n",
